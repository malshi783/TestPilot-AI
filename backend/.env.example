PORT=5000

# PostgreSQL connection. Use DATABASE_URL OR the DB_* values below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_NAME=testpilot_ai
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
DB_SSL=false

# Replace with a long, random secret. Never commit a real .env file.
JWT_SECRET=replace_with_a_long_random_secret

# Vite may use either 5173 or 5174 depending on local availability.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional OpenAI-compatible API. Empty key enables the local demo generator.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
